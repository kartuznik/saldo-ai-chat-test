# Ключ OpenRouter. Где взять: openrouter.ai → Settings → API Keys → Create New Key.
# Живёт ТОЛЬКО в server/.env (файл не коммитится); этот файл — шаблон без значений.
OPENROUTER_API_KEY=
# ID модели из каталога OpenRouter; бесплатные варианты имеют суффикс :free.
# Каталог: openrouter.ai/models (фильтр free). Читается сервером при старте.
MODEL=
